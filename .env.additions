# Ubah baris yang sudah ada di file .env menjadi seperti berikut (jangan menambah baris ganda):
APP_NAME="FCM KNN Churn"

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=churn_fuzzy
DB_USERNAME=root
DB_PASSWORD=

# Tambahkan di bagian paling bawah .env:
FUZZY_API_URL=http://127.0.0.1:8001
FUZZY_API_TIMEOUT=300
